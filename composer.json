{
  "name": "wagnerwagner/merx.wagnerwagner.de",
  "description": "Documentation and shop of the Merx Plugin for Kirby.",
  "type": "project",
  "homepage": "https://merx.wagnerwagner.de",
  "require": {
    "php": "~8.3.0 || ~8.4.0 || ~8.5.0"
  },
  "scripts": {
    "start": [
      "Composer\\Config::disableProcessTimeout",
      "@php -S localhost:8181 kirby/router.php"
    ],
    "fix": "cpx getkirby/php-cs:^0.2 fix",
    "check-examples": "@php scripts/check-php-examples.php",
    "license-keys": "@php scripts/license-fingerprints.php",
    "test": "@composer --working-dir=site/plugins/site run test"
  }
}
