{
	"name": "merx-wagnerwagner-de",
	"description": "Website of Merx by Wagnerwagner",
	"version": "2.0.0",
	"scripts": {
		"js": "esbuild develop/js/index.js --bundle --outdir=public/assets/js --minify --sourcemap --target=es2020",
		"js-dev": "esbuild develop/js/index.js --bundle --outdir=public/assets/js --sourcemap --target=es2020 --watch",
		"js-lint": "npx eslint --fix develop/js",
		"css": "npx postcss develop/css/*.css --dir public/assets/css -m --env production",
		"css-dev": "npx postcss develop/css/*.css --dir public/assets/css -m -w --env development",
		"svg": "./scripts/build-svg-sprite.sh",
		"build": "npm run css; npm run js-lint; npm run js; npm run svg;",
		"start-local-dev-server": "local-dev-server up",
		"stop-local-dev-server": "local-dev-server down"
	},
	"author": "tobias.wolf@wagnerwagner.de",
	"devDependencies": {
		"@csstools/postcss-color-mix-function": "^2.0.10",
		"@csstools/postcss-oklab-function": "^2.2.3",
		"@stripe/stripe-js": "^8.7.0",
		"autoprefixer": "^10.4.17",
		"cssnano": "^5.1.15",
		"esbuild": "^0.28.0",
		"eslint": "^8.56.0",
		"eslint-config-airbnb-base": "^15.0.0",
		"eslint-plugin-import": "^2.29.1",
		"local-dev-server": "file:../local-dev-server",
		"postcss": "^8.4.35",
		"postcss-cli": "^10.1.0",
		"postcss-import": "^15.1.0",
		"postcss-nesting": "^11.3.0"
	},
	"config": {
		"localDevServer": {
			"domain": "merx.wagnerwagner.test",
			"php": "8.5",
			"docroot": "public"
		}
	}
}
